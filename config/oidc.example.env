# Trusted OAuth 2.0 / OpenID Provider configuration.
# Replace every example URL and identifier before starting the gateway.
CONTEXT_BREACH_OIDC_ISSUER=https://identity.example.com/realms/company
CONTEXT_BREACH_OIDC_AUDIENCE=context-breach-gateway
CONTEXT_BREACH_OIDC_JWKS_URL=https://identity.example.com/realms/company/protocol/openid-connect/certs
CONTEXT_BREACH_OIDC_AGENT_ID=research-agent

# Claim names in the signed JWT access token.
CONTEXT_BREACH_OIDC_TENANT_CLAIM=tenant_id
CONTEXT_BREACH_OIDC_USER_CLAIM=sub
CONTEXT_BREACH_OIDC_GROUPS_CLAIM=groups
CONTEXT_BREACH_OIDC_SCOPE_CLAIM=scope

# Production issuers and JWKS endpoints must use HTTPS. Set this only for a
# loopback-only local identity provider such as http://127.0.0.1:8080.
CONTEXT_BREACH_OIDC_ALLOW_INSECURE_HTTP=false
